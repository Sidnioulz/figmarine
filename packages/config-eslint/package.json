{
  "name": "@figmarine/config-eslint",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "ESLint config package for the Figmarine monorepo",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sidnioulz/figmarine",
    "directory": "packages/config-eslint"
  },
  "scripts": {
    "build": "tsc"
  },
  "bugs": {
    "url": "https://github.com/Sidnioulz/figmarine/issues"
  },
  "keywords": [
    "config",
    "eslint"
  ],
  "author": "Steve Dodier-Lazaro",
  "homepage": "https://github.com/Sidnioulz/figmarine",
  "files": [
    "*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./*.js"
    }
  },
  "dependencies": {
    "@eslint/json": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-only-warn": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}