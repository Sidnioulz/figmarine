{
  "extends": "./base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    // tsup's dts worker injects the deprecated `baseUrl` option; drop when tsup is TS 6 clean.
    "ignoreDeprecations": "6.0",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "noEmit": false,
    "target": "ESNext",
    "types": [
      "node",
      "vitest/globals"
    ]
  }
}